<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- اللون الأساسي -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- اللون الثانوي -->
        <item name="colorSecondary">@color/primary_color</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- خلفية التطبيق -->
        <item name="android:colorBackground">@color/bg_dark</item>

        <!-- لون سطح العناصر -->
        <item name="colorSurface">@color/surface_dark</item>

        <!-- النصوص القياسية -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>

        <!-- شريط الحالة -->
        <item name="android:statusBarColor">@color/bg_dark</item>

        <!-- النص/الأيقونة في شريط الحالة -->
        <item name="android:windowLightStatusBar">false</item>

    </style>

</resources>
