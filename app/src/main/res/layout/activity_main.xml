<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- ========================= -->
    <!-- 1. الشريط العلوي -->
    <!-- ========================= -->

    <com.google.android.material.appbar.MaterialToolbar
    android:id="@+id/toolbar"
    android:layout_width="0dp"
    android:layout_height="64dp"
    android:background="@android:color/white"
    android:elevation="0dp"
    app:title="إدارة المخزون"
    app:titleTextColor="@android:color/black"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="end">

        <!-- ترتيب -->
        <ImageView
            android:id="@+id/btnSort"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_sort"
            android:tint="#1976D2"
            android:contentDescription="ترتيب"
            android:clickable="true"
            android:focusable="true" />

        <!-- مساعدة -->
        <ImageView
            android:id="@+id/btnHelp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_help"
            android:tint="#1976D2"
            android:contentDescription="مساعدة"
            android:clickable="true"
            android:focusable="true" />

        <!-- إعدادات -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            android:tint="#555555"
            android:contentDescription="إعدادات"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</com.google.android.material.appbar.MaterialToolbar>
    

    <!-- ========================= -->
    <!-- الخط السفلي للشريط العلوي -->
    <!-- ========================= -->

    <View
        android:id="@+id/toolbarDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#333333"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================================= -->
    <!-- 2 & 3. شريط البحث والأزرار في سطر واحد افقي -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/searchAndActionsBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:animateLayoutChanges="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- حقل البحث -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardBackgroundColor="#F1F3F4"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeColor="#D0D0D0"
            app:strokeWidth="1dp"
            app:cardPreventCornerOverlap="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#777777" />

                <EditText
                    android:id="@+id/searchField"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="بحث عن منتج..."
                    android:textSize="15sp"
                    android:textColor="@android:color/black"
                    android:textColorHint="#777777"
                    android:maxLines="1"
                    android:inputType="text"
                    android:importantForAutofill="no" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- حاوية الأزرار جهة اليسار -->
        <LinearLayout
            android:id="@+id/actionsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:visibility="visible">

            <!-- زر اختيار متعدد -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMultiSelect"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="اختيار متعدد"
                android:textSize="11sp"
                android:textColor="#333333"
                android:layout_marginEnd="4dp"
                app:backgroundTint="#F1F3F4"
                app:strokeColor="#D0D0D0"
                app:strokeWidth="1dp"
                app:cornerRadius="20dp"
                app:elevation="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- زر ترتيب حسب -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortBy"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="ترتيب حسب"
                android:textSize="11sp"
                android:textColor="#333333"
                app:backgroundTint="#F1F3F4"
                app:strokeColor="#D0D0D0"
                app:strokeWidth="1dp"
                app:cornerRadius="20dp"
                app:elevation="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

    </LinearLayout>


    <!-- ========================= -->
    <!-- 4. قائمة التصنيفات -->
    <!-- ========================= -->

    <HorizontalScrollView
        android:id="@+id/categoriesScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:fillViewport="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:layoutDirection="rtl"
        app:layout_constraintTop_toBottomOf="@id/searchAndActionsBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@android:color/white"
            android:layoutDirection="rtl"
            app:singleSelection="true"
            app:singleLine="true"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="0dp" />

    </HorizontalScrollView>


    <!-- ========================= -->
    <!-- الكاميرا -->
    <!-- ========================= -->

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================= -->
    <!-- قائمة المنتجات -->
    <!-- ========================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/categoriesScroll"
        app:layout_constraintBottom_toTopOf="@id/fab"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================================= -->
    <!-- الأزرار العائمة عند الضغط المطول -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/floatingActionsMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="0dp">

        <!-- تعديل -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnActionEdit"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:contentDescription="تعديل"
            android:src="@drawable/ic_edit"
            android:scaleType="center"
            app:backgroundTint="#FFFFFF"
            app:tint="@null"
            app:borderWidth="0dp"
            app:elevation="8dp"
            app:pressedTranslationZ="12dp" />

        <!-- PDF -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnActionPdf"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:contentDescription="PDF"
            android:src="@drawable/icpdf"
            android:scaleType="center"
            app:backgroundTint="#FFFFFF"
            app:tint="@null"
            app:borderWidth="0dp"
            app:elevation="8dp"
            app:pressedTranslationZ="12dp" />

        <!-- طباعة -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnActionPrint"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:contentDescription="طباعة"
            android:src="@drawable/icprint"
            android:scaleType="center"
            app:backgroundTint="#FFFFFF"
            app:tint="@null"
            app:borderWidth="0dp"
            app:elevation="8dp"
            app:pressedTranslationZ="12dp" />

        <!-- حذف -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnActionDelete"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:contentDescription="حذف"
            android:src="@drawable/icdeletered"
            android:scaleType="center"
            app:backgroundTint="#FFFFFF"
            app:tint="@null"
            app:borderWidth="0dp"
            app:elevation="8dp"
            app:pressedTranslationZ="12dp" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- زر الإضافة -->
    <!-- ========================= -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="إضافة / مسح"
        android:src="@drawable/ic_barcode"
        app:backgroundTint="#FFFFFF"
        app:tint="@null"
        app:strokeColor="#555555"
        app:strokeWidth="1dp"
        app:elevation="6dp"
        app:pressedTranslationZ="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
                    
