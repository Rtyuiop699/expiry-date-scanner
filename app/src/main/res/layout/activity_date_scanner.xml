<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ===================================================== -->
    <!-- معاينة الكاميرا -->
    <!-- ===================================================== -->

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:scaleType="fitCenter" />


    <!-- ===================================================== -->
    <!-- إطار التعرف على التاريخ -->
    <!-- ===================================================== -->

    <FrameLayout
        android:layout_width="320dp"
        android:layout_height="140dp"
        android:layout_gravity="center">

        <!-- الخط العلوي -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:background="#00FF00" />

        <!-- الخط السفلي -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:background="#00FF00" />

        <!-- الخط الأيسر -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#00FF00" />

        <!-- الخط الأيمن -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#00FF00" />


        <!-- ================================================= -->
        <!-- الزوايا -->
        <!-- ================================================= -->

        <!-- أعلى يسار -->
        <View
            android:layout_width="28dp"
            android:layout_height="4dp"
            android:layout_gravity="top|start"
            android:background="#00FF00" />

        <View
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:background="#00FF00" />


        <!-- أعلى يمين -->
        <View
            android:layout_width="28dp"
            android:layout_height="4dp"
            android:layout_gravity="top|end"
            android:background="#00FF00" />

        <View
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:background="#00FF00" />


        <!-- أسفل يسار -->
        <View
            android:layout_width="28dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|start"
            android:background="#00FF00" />

        <View
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|start"
            android:background="#00FF00" />


        <!-- أسفل يمين -->
        <View
            android:layout_width="28dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|end"
            android:background="#00FF00" />

        <View
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:background="#00FF00" />

    </FrameLayout>


    <!-- ===================================================== -->
    <!-- تعليمات المستخدم -->
    <!-- ===================================================== -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="90dp"
        android:background="#99000000"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="ضع تاريخ الانتهاء داخل الإطار"
        android:textColor="#00FF00"
        android:textSize="14sp"
        android:textStyle="bold" />


    <!-- ===================================================== -->
    <!-- اللوحة السفلية -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp"
        android:background="#CC000000">


        <!-- ================================================= -->
        <!-- نتيجة OCR -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvRecognizedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#F2F2F2"
            android:gravity="center"
            android:maxLines="3"
            android:minHeight="52dp"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="سوف يظهر التاريخ المكتشف هنا"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />



        <!-- ================================================= -->
<!-- أزرار التحكم - أيقونات عائمة بدون إطار -->
<!-- ================================================= -->

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <!-- ============================================= -->
    <!-- الفلاش -->
    <!-- ============================================= -->

    <ImageButton
        android:id="@+id/btnFlash"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_margin="6dp"
        android:background="@android:color/transparent"
        android:contentDescription="تشغيل الفلاش"
        android:padding="2dp"
        android:src="@drawable/ic_flash"
        android:scaleType="fitCenter" />


    <!-- ============================================= -->
    <!-- التصوير -->
    <!-- ============================================= -->

    <ImageButton
        android:id="@+id/btnTakePicture"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@android:color/transparent"
        android:contentDescription="التقاط صورة"
        android:padding="1dp"
        android:src="@drawable/ic_camera"
        android:scaleType="fitCenter" />


    <!-- ============================================= -->
    <!-- استخدام التاريخ -->
    <!-- ============================================= -->

    <ImageButton
        android:id="@+id/btnUseDate"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_margin="6dp"
        android:background="@android:color/transparent"
        android:contentDescription="استخدام التاريخ"
        android:enabled="false"
        android:padding="2dp"
        android:src="@drawable/ic_check"
        android:scaleType="fitCenter" />


    <!-- ============================================= -->
    <!-- S.OCR -->
    <!-- ============================================= -->

    <ImageButton
        android:id="@+id/btnSOCR"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_margin="6dp"
        android:background="@android:color/transparent"
        android:contentDescription="التعرف بالذكاء الاصطناعي"
        android:padding="2dp"
        android:src="@drawable/ic_socr"
        android:scaleType="fitCenter" />

</LinearLayout>
    </LinearLayout>

</FrameLayout>
