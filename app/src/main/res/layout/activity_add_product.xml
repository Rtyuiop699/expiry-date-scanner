<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- ============================= -->
    <!-- الشريط العلوي -->
    <!-- ============================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/toolbar_border"
        android:elevation="0dp"
        app:navigationIcon="@drawable/icarrowback"
        app:title="إضافة منتج"
        app:titleTextColor="#000000"
        app:menu="@menu/addproductmenu" />


    <!-- ============================= -->
    <!-- منطقة التمرير -->
    <!-- ============================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- ============================= -->
            <!-- الصورة وأزرار الصور -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnCaptureImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="التقاط صورة"/>

                    <Button
                        android:id="@+id/btnChooseImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="اختيار صورة"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:id="@+id/imageViewProduct"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#DDDDDD"
                        android:src="@android:drawable/ic_menu_camera"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ============================= -->
            <!-- التصنيف + زر الإضافة -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/menuCategories"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="التصنيف">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:padding="16dp"/>

                </com.google.android.material.textfield.TextInputLayout>


                <!-- زر إضافة التصنيف -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCategory"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:contentDescription="إضافة تصنيف"
                    app:backgroundTint="#025144"
                    app:cornerRadius="16dp"
                    app:elevation="5dp"
                    app:strokeWidth="0dp"/>

            </LinearLayout>


            <!-- ============================= -->
            <!-- اسم المنتج -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="اسم المنتج"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ictagred"
                    android:layout_marginStart="8dp"
                    android:tint="#F44336"/>

            </LinearLayout>


            <!-- ============================= -->
            <!-- الباركود -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="رمز الباركود"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextBarcode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"/>

                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/icbarcode"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>


            <!-- ============================= -->
            <!-- التاريخ + OCR + التقويم -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:layout_marginTop="16dp">


                <!-- زر OCR -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanDate"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="OCR"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:contentDescription="مسح تاريخ الانتهاء"
                    app:backgroundTint="#025144"
                    app:cornerRadius="16dp"
                    app:elevation="5dp"
                    app:strokeWidth="0dp"/>


                <!-- حقل التاريخ -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="تاريخ الانتهاء"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date"/>

                </com.google.android.material.textfield.TextInputLayout>


                <!-- أيقونة التقويم -->
                <ImageView
                    android:id="@+id/iconCalendar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/iccalendar"
                    android:tint="#4CAF50"
                    android:contentDescription="تاريخ الانتهاء"/>

            </LinearLayout>


            <!-- ============================= -->
            <!-- الكمية -->
            <!-- ============================= -->

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <!-- العناوين -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="3">

                    <TextView
                        android:text="كرتون"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="باكت في الكرتون"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="حبة في الباكت"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>

                </LinearLayout>


                <!-- حقول الكمية -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="3"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/editCarton"
                        android:hint="عدد الكراتين"
                        android:inputType="number"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:id="@+id/editPack"
                        android:hint="عدد الباكت"
                        android:inputType="number"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:id="@+id/editPiece"
                        android:hint="عدد الحبات"
                        android:inputType="number"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>

                </LinearLayout>


                <!-- يوجد باكت -->
                <Button
                    android:id="@+id/btnHasPack"
                    android:text="يوجد باكت ✔️"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"/>


                <!-- احسب + النتيجة -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btnCalculate"
                        android:text="احسب"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:id="@+id/editResult"
                        android:hint="النتيجة"
                        android:enabled="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
