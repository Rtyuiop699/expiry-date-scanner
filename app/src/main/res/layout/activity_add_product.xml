<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- ========================= -->
    <!-- شريط العنوان -->
    <!-- ========================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/toolbar_border"
        android:elevation="0dp"
        app:navigationIcon="@drawable/icarrowback"
        app:title="إضافة منتج"
        app:titleTextColor="#000000"
        app:menu="@menu/addproductmenu" />


    <!-- ========================= -->
    <!-- المحتوى -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- ================================================= -->
            <!-- الصورة وأزرار الصورة -->
            <!-- الصورة يمين - الأزرار يسار -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- ========================= -->
                <!-- أزرار الصورة - اليسار -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="12dp">

                    <Button
                        android:id="@+id/btnCaptureImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="التقاط صورة" />

                    <Button
                        android:id="@+id/btnChooseImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="اختيار صورة"
                        android:layout_marginTop="8dp" />

                </LinearLayout>


                <!-- ========================= -->
                <!-- صورة المنتج - اليمين -->
                <!-- ========================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:id="@+id/imageViewProduct"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#DDDDDD"
                        android:src="@android:drawable/ic_menu_camera" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ========================= -->
            <!-- التصنيف -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/menuCategories"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="التصنيف">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:padding="16dp" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- زر إضافة تصنيف -->

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnAddCategory"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="إضافة تصنيف"
                    android:src="@drawable/ic_add_white"
                    app:backgroundTint="#025144"
                    app:tint="#FFFFFF"
                    app:elevation="6dp"
                    app:fabSize="normal" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- اسم المنتج -->
            <!-- الأيقونة يمين الحقل -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <!-- أيقونة اسم المنتج - اليمين -->

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ictagred"
                    android:tint="#F44336"
                    android:contentDescription="اسم المنتج" />


                <!-- حقل اسم المنتج -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="اسم المنتج"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <!-- ========================= -->
            <!-- رمز الباركود -->
            <!-- الأيقونة يمين الحقل -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <!-- أيقونة الباركود - اليمين -->

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/icbarcode"
                    android:contentDescription="رمز الباركود" />


                <!-- حقل الباركود -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="رمز الباركود"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextBarcode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <!-- ========================= -->
            <!-- تاريخ الانتهاء + OCR -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:layout_marginTop="16dp">

                <!-- زر OCR -->

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnScanDate"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="مسح تاريخ الانتهاء"
                    android:src="@drawable/ic_ocr"
                    app:backgroundTint="#025144"
                    app:tint="#FFFFFF"
                    app:elevation="6dp"
                    app:fabSize="normal" />


                <!-- حقل تاريخ الانتهاء -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="تاريخ الانتهاء"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- أيقونة التقويم -->

                <ImageView
                    android:id="@+id/iconCalendar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/iccalendar"
                    android:tint="#4CAF50"
                    android:contentDescription="تاريخ الانتهاء" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
<!-- ========================= -->
<!-- الكميات والأسعار -->
<!-- ========================= -->

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp">

    <!-- عنوان القسم بخط أخضر مقطوع -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#00FF66" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  الكميات والأسعار  "
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#00FF66" />

    </LinearLayout>

    <!-- ========================= -->
    <!-- الكميات -->
    <!-- ========================= -->

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3"
        android:layout_marginTop="16dp">

        <!-- الكراتين -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="عدد الكراتين"
                android:gravity="center" />

            <EditText
                android:id="@+id/editCarton"
                android:hint="الكراتين"
                android:inputType="number"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- الباكت -->
        <LinearLayout
            android:id="@+id/layoutPackQuantity"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الباكت في الكرتون"
                android:gravity="center" />

            <EditText
                android:id="@+id/editPack"
                android:hint="الباكت"
                android:inputType="number"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- الحبات -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الحبات في الباكت"
                android:gravity="center" />

            <EditText
                android:id="@+id/editPiece"
                android:hint="الحبات"
                android:inputType="number"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

    <!-- ========================= -->
    <!-- زر يوجد باكت -->
    <!-- ========================= -->

    <Button
        android:id="@+id/btnHasPack"
        android:text="يوجد باكت ✓"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <!-- زر الحساب -->
    <Button
        android:id="@+id/btnCalculate"
        android:text="احسب"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />
    <!-- ========================= -->
<!-- الأسعار -->
<!-- ========================= -->

<LinearLayout
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp">

    <!-- ========================= -->
    <!-- عمود الشراء -->
    <!-- ========================= -->

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="5dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="أسعار الشراء"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- سعر شراء الكرتون - إدخال -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="سعر شراء الكرتون">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editCartonPurchasePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- سعر شراء الباكت -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPackPurchasePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="سعر شراء الباكت">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tvPackPurchasePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- سعر شراء الحبة -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="سعر شراء الحبة">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tvPiecePurchasePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- إجمالي الشراء -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="إجمالي الشراء">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tvTotalPurchasePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- ========================= -->
    <!-- عمود البيع -->
    <!-- ========================= -->

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="5dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="أسعار البيع"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- سعر بيع الحبة - إدخال -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="سعر بيع الحبة">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPieceSalePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- سعر بيع الباكت -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPackSalePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="سعر بيع الباكت">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tvPackSalePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- سعر بيع الكرتون -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="سعر بيع الكرتون">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tvCartonSalePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- إجمالي البيع -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="إجمالي البيع">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tvTotalSalePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</LinearLayout>
                    <!-- ========================= -->
                <!-- الأرباح -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الأرباح"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2">

                    <!-- أرباح الحبة والباكت -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp">

                        <!-- ربح الحبة -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="الربح في الحبة">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/tvPieceProfit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:clickable="false" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- ربح الباكت -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutPackProfit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="الربح في الباكت">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/tvPackProfit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:clickable="false" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- أرباح الكرتون والإجمالي -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp">

                        <!-- ربح الكرتون -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="الربح في الكرتون">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/tvCartonProfit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:clickable="false" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- إجمالي الربح -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="إجمالي الربح">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/tvTotalProfit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:clickable="false" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>   <!-- إغلاق LinearLayout الخاص بالكميات والأسعار -->

        </LinearLayout>       <!-- إغلاق LinearLayout الداخلي (الموجود داخل ScrollView) -->

    </ScrollView>

</LinearLayout>               <!-- إغلاق LinearLayout الخارجي -->
    
            
