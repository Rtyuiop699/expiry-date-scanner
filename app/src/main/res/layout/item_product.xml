<?xml version="1.0" encoding="utf-8"?><LinearLayout
xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical">

<!-- ========================================================= -->
<!-- المحتوى الرئيسي -->
<!-- المواضع ثابتة فعليًا: المعلومات يسار / الاسم وسط / الصورة يمين -->
<!-- ========================================================= -->

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:padding="8dp">

    <!-- ===================================================== -->
    <!-- 1. معلومات المنتج - أقصى اليسار -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/infoContainer"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:layout_gravity="left|center_vertical"
        android:orientation="vertical"
        android:gravity="left|center_vertical">

        <!-- تاريخ الانتهاء -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="left|center_vertical">

            <TextView
                android:id="@+id/textViewExpiryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تاريخ الانتهاء"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:gravity="left" />

            <TextView
                android:id="@+id/textViewExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="11/9/2026"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:gravity="left"
                android:textDirection="ltr" />

        </LinearLayout>

        <!-- الأيام المتبقية -->

        <TextView
            android:id="@+id/textViewRemaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="متبقي 5 أيام"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:gravity="left" />

        <!-- الباركود -->

        <TextView
            android:id="@+id/textViewBarcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="846046484"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="left"
            android:textDirection="ltr" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- 2. صورة المنتج - أقصى اليمين -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imageViewProduct"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="right|center_vertical"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_report_image"
        android:background="@android:color/darker_gray" />


    <!-- ===================================================== -->
    <!-- 3. اسم المنتج - في المنطقة الوسطى -->
    <!-- ===================================================== -->

    <TextView
    android:id="@+id/textViewName"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_gravity="center_vertical"

    android:layout_marginLeft="138dp"
    android:layout_marginRight="82dp"

    android:text="قوة جبل مشروب غازي 500 ملي"
    android:textSize="16sp"
    android:textStyle="bold"
    android:textColor="@android:color/black"

    android:gravity="center_vertical|right"
    android:textDirection="rtl"
    android:layoutDirection="rtl"

    android:maxLines="3"
    android:ellipsize="end"

    android:breakStrategy="simple"
    android:hyphenationFrequency="none"

    android:includeFontPadding="true" />

<!-- ========================================================= -->
<!-- الخط الفاصل بين المنتجات -->
<!-- ========================================================= -->

<View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:background="#D9D9D9" />

</LinearLayout>
