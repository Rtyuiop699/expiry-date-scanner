<?xml version="1.0" encoding="utf-8"?><LinearLayout
xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical">

<!-- ========================================================= -->
<!-- المحتوى الرئيسي -->
<!-- ========================================================= -->

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:padding="8dp">

    <!-- ===================================================== -->
    <!-- 1. المعلومات - مثبتة في أقصى اليسار -->
    <!-- التاريخ -->
    <!-- المتبقي -->
    <!-- الباركود -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/infoContainer"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:layout_gravity="start|center_vertical"
        android:orientation="vertical"
        android:gravity="start|center_vertical">

        <!-- تاريخ الانتهاء -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical">

            <TextView
                android:id="@+id/textViewExpiryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تاريخ الانتهاء"
                android:textSize="14sp"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/textViewExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="11/9/2026"
                android:textSize="14sp"
                android:textColor="@android:color/black" />

        </LinearLayout>

        <!-- الأيام المتبقية -->

        <TextView
            android:id="@+id/textViewRemaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="متبقي 5 أيام"
            android:textSize="14sp"
            android:textColor="@android:color/black" />

        <!-- الباركود -->

        <TextView
            android:id="@+id/textViewBarcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="846046484"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- 2. الصورة - مثبتة في أقصى اليمين -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imageViewProduct"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="end|center_vertical"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_report_image"
        android:background="@android:color/darker_gray" />


    <!-- ===================================================== -->
    <!-- 3. اسم المنتج - المنطقة الوسطى -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/textViewName"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="138dp"
        android:layout_marginEnd="88dp"
        android:text="ايسكريم نانا"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none" />

</FrameLayout>


<!-- ========================================================= -->
<!-- الخط الفاصل بين المنتجات -->
<!-- ========================================================= -->

<View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:background="#D9D9D9" />

</LinearLayout>
