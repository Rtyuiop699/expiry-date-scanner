<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- المعلومات (يسار) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <!-- الاسم -->
        <!-- الاسم -->
<TextView
    android:id="@+id/textViewName"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Product Name"
    android:textSize="16sp"
    android:textStyle="bold"
    android:textColor="@android:color/black" />

<!-- عبارة تاريخ الانتهاء -->
<TextView
    android:id="@+id/textViewExpiryLabel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="تاريخ الانتهاء"
    android:textSize="13sp"
    android:textColor="@android:color/darker_gray"
    android:layout_marginTop="4dp" />

<!-- تاريخ الانتهاء -->
<TextView
    android:id="@+id/textViewExpiry"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="2026-08-11"
    android:textSize="14sp"
    android:textColor="@android:color/black" />

<!-- الأيام المتبقية -->
<TextView
    android:id="@+id/textViewRemaining"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="متبقي 20 يوم"
    android:textSize="14sp"
    android:textColor="@android:color/black"
    android:layout_marginTop="2dp" />

<!-- الباركود -->
<TextView
    android:id="@+id/textViewBarcode"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Barcode: 123456"
    android:textSize="13sp"
    android:textColor="@android:color/darker_gray" />
