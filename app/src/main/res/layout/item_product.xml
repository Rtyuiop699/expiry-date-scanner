<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- المعلومات -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <!-- اسم المنتج -->
        <TextView
            android:id="@+id/textViewName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <!-- عبارة تاريخ الانتهاء -->
        <TextView
            android:id="@+id/textViewExpiryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="تاريخ الانتهاء"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray" />

        <!-- تاريخ الانتهاء -->
        <TextView
            android:id="@+id/textViewExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-08-11"
            android:textSize="14sp"
            android:textColor="@android:color/black" />

        <!-- الأيام المتبقية -->
        <TextView
            android:id="@+id/textViewRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="متبقي 20 يوم"
            android:textSize="14sp"
            android:textColor="@android:color/black" />

        <!-- الباركود -->
        <TextView
            android:id="@+id/textViewBarcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Barcode: 123456"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray" />

    </LinearLayout>

    <!-- صورة المنتج -->
    <ImageView
        android:id="@+id/imageViewProduct"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_report_image"
        android:background="@android:color/darker_gray" />

</LinearLayout>
